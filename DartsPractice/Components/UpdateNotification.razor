@inject IJSRuntime JS

@if (updateAvailable)
{
    <div class="update-banner">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-down-circle-fill text-warning fs-5"></i>
                    <span class="text-light">A new version is available!</span>
                </div>
                <button class="btn btn-sm btn-success" @onclick="ApplyUpdate">
                    <i class="bi bi-download me-1"></i> Update Now
                </button>
            </div>
        </div>
    </div>
}

<style>
    .update-banner {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        border-top: 2px solid #4CAF50;
        padding: 0.75rem 1rem;
        z-index: 9999;
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.5);
        animation: slideUp 0.3s ease-out;
    }

    @@keyframes slideUp {
        from {
            transform: translateY(100%);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .update-banner .btn-success {
        background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
        border: none;
        font-weight: 600;
    }

    .update-banner .btn-success:hover {
        background: linear-gradient(135deg, #45a049 0%, #3d8b40 100%);
    }
</style>

@code {
    private bool updateAvailable = false;
    private DotNetObjectReference<UpdateNotification>? dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pwaUpdate.initWithCallback", dotNetRef);
        }
    }

    [JSInvokable]
    public void NotifyUpdateAvailable()
    {
        updateAvailable = true;
        StateHasChanged();
    }

    private async Task ApplyUpdate()
    {
        await JS.InvokeVoidAsync("pwaUpdate.applyUpdate");
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}
