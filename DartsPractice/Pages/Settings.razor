@page "/settings"
@using DartsPractice.Services
@inject DataBackupService Backup
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="container py-4" style="max-width: 500px;">
    <h4>⚙️ Portability Settings</h4><hr/>
    <button class="btn btn-success w-100 mb-4" @onclick="Export">Export App Data (.json)</button>
    <div class="border p-3 rounded bg-light mb-3">
        <label class="small fw-bold mb-2">Import Conflicts Strategy:</label>
        <div class="form-check"><input type="radio" class="form-check-input" id="m" checked="@(!_over)" @onclick="() => _over=false"/><label class="form-check-label small" for="m">Merge Rows</label></div>
        <div class="form-check"><input type="radio" class="form-check-input" id="o" checked="@_over" @onclick="() => _over=true"/><label class="form-check-label small text-danger" for="o">Overwrite Database</label></div>
    </div>
    <InputFile class="form-control" OnChange="Import" accept=".json" />
    @if (!string.IsNullOrEmpty(_msg)) { <div class="alert alert-info mt-3 small">@_msg</div> }
</div>

@code {
    private bool _over = false; private string _msg = string.Empty;
    private async Task Export() => await JS.InvokeVoidAsync("downloadJsonFileHelper", $"darts_backup_{DateTime.Now:yyyyMMdd}.json", await Backup.ExportDataAsync());
    private async Task Import(InputFileChangeEventArgs e)
    {
        try {
            using var r = new StreamReader(e.File.OpenReadStream(1024*1024*5));
            _msg = await Backup.ImportDataAsync(await r.ReadToEndAsync(), _over) ? "🎉 Data synchronized successfully!" : "❌ Import layout corrupted.";
        } catch (Exception ex) { _msg = $"Error: {ex.Message}"; }
    }
}