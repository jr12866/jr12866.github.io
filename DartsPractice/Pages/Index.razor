@page "/"
@using System.Text.Json
@using DartsPractice.Data
@using DartsPractice.Core.Interfaces
@using IndexedDB.Blazor
@using DartsPractice.Core.Models
@using DartsPractice.PluginsHanders
@using DartsPractice.Services
@inject WasmPluginLoader PluginLoader
@inject GameStateContainer StateContainer
@inject IIndexedDbFactory DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="dashboard-container">
    <!-- Mobile Header -->
    <header class="dashboard-header">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="dashboard-title">Darts Station</h1>
                    <p class="dashboard-subtitle">Select a game to begin</p>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-sm btn-outline-light" @onclick='() => Nav.NavigateTo("/profiles")'>👥 Profiles</button>
                    <button class="btn btn-sm btn-outline-light" @onclick='() => Nav.NavigateTo("/history")'>📋 History</button>
                    <div class="stat-card d-inline-block px-3 py-2">
                        <span class="stat-card-value">@(_games?.Count ?? 0)</span>
                        <div class="stat-card-label">Games</div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Game Mode Tiles Grid -->
    <section class="py-4">
        <div class="container">
            @if (_games == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-success mb-3" role="status"></div>
                    <p class="text-secondary">Loading game modules...</p>
                </div>
            }
            else if (_games.Any())
            {
                <div class="row g-3">
                    @foreach (var game in _games)
                    {
                        <div class="col-6 col-md-4">
                            <button class="game-tile w-100 text-start @(IsGameSelected(game) ? "active" : "")"
                                    @onclick="() => SelectGame(game)"
                                    style="border: none; background: none; padding: 0;">
                                @if (IsGameSelected(game))
                                {
                                    <div class="game-tile-active-indicator"></div>
                                }
                                <div class="game-tile-icon">
                                    <i class="bi @GetGameIcon(game)"></i>
                                </div>
                                <div class="game-tile-title">@game.Name</div>
                                <div class="game-tile-desc">@game.Description</div>
                                <div class="game-tile-badge">
                                    <i class="bi bi-play-fill"></i>
                                    @GetGameInputLabel(game)
                                </div>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-secondary mb-3"></i>
                    <p class="text-secondary">No game modules found</p>
                </div>
            }
        </div>
    </section>

    <!-- Quick Stats Row -->
    @if (_records != null && _records.Any())
    {
        <section class="py-4 border-top border-dark">
            <div class="container">
                <div class="row g-3 text-center">
                    <div class="col-4">
                        <div class="stat-card">
                            <div class="stat-card-value">@_records.Count</div>
                            <div class="stat-card-label">Sessions</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-card">
                            <div class="stat-card-value">@(_records.TakeLast(7).Count())</div>
                            <div class="stat-card-label">This Week</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-card">
                            <div class="stat-card-value">@GetTopGame()</div>
                            <div class="stat-card-label">Top Game</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- Start Session Button -->
    @if (_games != null && _games.Any() && _selectedGame != null)
    {
        <section class="py-4 pb-5">
            <div class="container">
                <button class="btn btn-success btn-lg w-100 py-3 fw-bold text-black"
                        @onclick="StartSession">
                    <i class="bi bi-play-fill me-2"></i>
                    Start @(_selectedGame?.Name ?? "Game")
                </button>
            </div>
        </section>
    }

    <!-- Recent Activity -->
    @if (_records != null && _records.Any())
    {
        <section class="py-4 border-top border-dark">
            <div class="container">
                <h2 class="dashboard-title fs-5 mb-3">Recent Sessions</h2>
                <div class="row g-2">
                    @foreach (var record in _records.TakeLast(5).Reverse())
                    {
                        <div class="col-12">
                            <div class="d-flex align-items-center justify-content-between p-3 rounded cursor-pointer"
                                 style="background: #1A1A1A; border: 1px solid #2A2A2A; cursor: pointer;"
                                 @onclick='() => Nav.NavigateTo($"/history/{record.SessionId}")'>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="game-tile-icon" style="width: 40px; height: 40px; margin: 0;">
                                        <i class="bi @GetGameIconByName(record.GameName)" style="font-size: 1rem;"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-white" style="font-size: 0.875rem;">@record.GameName</div>
                                        <div class="text-secondary" style="font-size: 0.75rem;">@record.DatePlayed.ToString("MMM d, yyyy")</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="text-success" style="font-size: 0.875rem;">@GetRecordScore(record)</div>
                                    <div class="text-secondary" style="font-size: 0.6875rem;">@GetRecordDetail(record)</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</div>

<style>
    .dashboard-container {
        min-height: 100vh;
        background: linear-gradient(180deg, #0D0D0D 0%, #1A1A1A 100%);
        padding-bottom: 2rem;
    }

    /* Hero Section - Minimal mobile header */
    .hero-section {
        display: none;
    }

    /* Override default card styles for dark theme */
    .card {
        background: #1A1A1A;
        border: 1px solid #2A2A2A;
        color: #F5F5F5;
    }

    .card-body {
        color: #F5F5F5;
    }

    .text-secondary {
        color: #A0A0A0 !important;
    }

    .text-dark {
        color: #FFFFFF !important;
    }

    .bg-light {
        background-color: #1A1A1A !important;
    }

    .border-top {
        border-color: #2A2A2A !important;
    }

    .border-dark {
        border-color: #2A2A2A !important;
    }

    /* Footer quick links */
    .py-5.border-top {
        display: none;
    }

    /* Metric cards section */
    section.py-5:first-of-type {
        display: none;
    }

    /* Module section */
    section.py-5.bg-light {
        background: transparent !important;
        padding: 0 !important;
    }

    /* Ensure touch targets are large enough */
    .game-tile {
        min-height: 180px !important;
    }
</style>

@code {
    private List<IDartsGame>? _games;
    private List<MatchRecord>? _records;
    private IDartsGame? _selectedGame;

    protected override async Task OnInitializedAsync()
    {
        _games = await PluginLoader.LoadPluginsAsync();
        await GetRecords();
        
        if (_games != null && _games.Any())
        {
            _selectedGame = _games.First();
        }
    }

    private bool IsGameSelected(IDartsGame game)
    {
        return _selectedGame == game;
    }

    private void SelectGame(IDartsGame game)
    {
        _selectedGame = game;
        StateContainer.SetGame(game);
        StateHasChanged();
    }

    private void StartSession()
    {
        if (_selectedGame != null)
        {
            StateContainer.SetGame(_selectedGame);
            Nav.NavigateTo("/play");
        }
    }

    private string GetGameIcon(IDartsGame game)
    {
        var name = game.Name.ToLowerInvariant();
        
        if (name.Contains("501") || name.Contains("x01") || name.Contains("point"))
            return "bi-calculator";
        if (name.Contains("cricket"))
            return "bi-bullseye";
        if (name.Contains("bob") || name.Contains("27") || name.Contains("double"))
            return "bi-award";
        if (name.Contains("round") || name.Contains("robin") || name.Contains("configurable"))
            return "bi-shuffle";
        
        return "bi-play-circle";
    }

    private string GetGameIconByName(string gameName)
    {
        var name = gameName.ToLowerInvariant();
        
        if (name.Contains("501") || name.Contains("x01") || name.Contains("point"))
            return "bi-calculator";
        if (name.Contains("cricket"))
            return "bi-bullseye";
        if (name.Contains("bob") || name.Contains("27") || name.Contains("double"))
            return "bi-award";
        if (name.Contains("round") || name.Contains("robin") || name.Contains("configurable"))
            return "bi-shuffle";
        
        return "bi-play-circle";
    }

    private string GetGameInputLabel(IDartsGame game)
    {
        return game.InputType == GameInputType.Score ? "Score Mode" : "Hit Count";
    }

    private async Task GetRecords()
    {
        try
        {
            using var db = await DbFactory.Create<DartsDb>();
            _records = db.MatchRecords?.ToList() ?? new List<MatchRecord>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading records: {ex.Message}");
            _records = new List<MatchRecord>();
        }
    }

    private string GetTopGame()
    {
        if (_records == null || !_records.Any()) return "-";
        
        var top = _records
            .GroupBy(r => r.GameName)
            .OrderByDescending(g => g.Count())
            .FirstOrDefault();
        
        if (top == null) return "-";
        
        var shortName = top.Key;
        if (shortName.Contains("501")) return "501";
        if (shortName.Contains("Cricket")) return "Cricket";
        if (shortName.Contains("Bob")) return "Bob's";
        if (shortName.Contains("Round")) return "Round";
        
        return shortName.Length > 8 ? shortName.Substring(0, 8) + "..." : shortName;
    }

    private string GetRecordScore(MatchRecord record)
    {
        try
        {
            var stats = JsonSerializer.Deserialize<List<PlayerSessionSummary>>(record.PlayerStatsJson);
            if (stats != null && stats.Any())
            {
                return $"{stats.Sum(s => s.TotalTurnsPlayed)} turns";
            }
        }
        catch { }
        return "-";
    }

    private string GetRecordDetail(MatchRecord record)
    {
        return record.DatePlayed.ToString("h:mm tt");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _records != null && _records.Any())
        {
            try
            {
                await JS.InvokeVoidAsync("initDashboardCharts", _records);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Chart init error: {ex.Message}");
            }
        }
    }
}