@page "/history"
@page "/history/{SessionId}"
@using DartsPractice.Core.Models
@using DartsPractice.Data
@using System.Text.Json
@using IndexedDB.Blazor
@inject IIndexedDbFactory DbFactory
@inject NavigationManager Nav

<div class="container py-4" style="max-width: 600px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4>📋 Match History Logs</h4>
        <button class="btn btn-sm btn-outline-secondary" @onclick='() => Nav.NavigateTo("")'>Home</button>
    </div>
    @if (_items == null) { <p>Loading...</p> }
    else if (!_items.Any()) { <p class="text-muted">No sessions saved yet.</p> }
    else
    {
    @foreach (var item in _items.AsEnumerable().Reverse())
    {
    <div class="card p-3 mb-2 small shadow-xs @(IsSessionHighlighted(item) ? "border-primary border-2" : "")">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="fw-bold">@item.GameName <span class="text-muted font-monospace ms-2" style="font-size: 0.75rem;">@item.DatePlayed.ToString("g")</span></div>
                <div class="text-success small mt-1">Winner: @item.WinnerName</div>
            </div>
            <button class="btn btn-sm @(IsDetailShown(item) ? "btn-primary" : "btn-outline-info")" @onclick="() => ToggleDetail(item)">
                @(IsDetailShown(item) ? "Hide" : "Details")
            </button>
        </div>
        <ul class="mt-2 pl-3 text-muted small">
            @foreach (var s in JsonSerializer.Deserialize<List<PlayerSessionSummary>>(item.PlayerStatsJson) ?? new())
            { <li>@s.PlayerName - @s.FinalStatus (@s.TotalTurnsPlayed Turns)</li> }
        </ul>
        @if (IsDetailShown(item))
        {
            <div class="mt-3 border-top pt-2">
                <h6 class="text-white mb-2">Darts Thrown</h6>
                @if (GetDetailedTurns(item).Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var turn in GetDetailedTurns(item))
                        {
                            <div class="bg-dark p-2 rounded text-center" style="min-width: 80px;">
                                <div class="small text-muted">Turn @(turn.TurnNumber)</div>
                                <div class="fw-bold text-primary">@turn.DisplayValue</div>
                                <div class="d-flex gap-1 justify-content-center flex-wrap mt-1">
                                    @foreach (var dart in turn.DartsThrown)
                                    {
                                        <span class="badge @(dart.Points > 0 ? "bg-success" : "bg-secondary")" style="font-size: 0.7rem;">@dart.DisplayName</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small">No detailed dart data available</p>
                }
            </div>
        }
    </div>
    }
    }
</div>

@code {
    [Parameter]
    public string? SessionId { get; set; }

    private List<MatchRecord>? _items;
    private HashSet<int> _expandedItems = new();
    private Dictionary<int, List<TurnResult>> _detailedTurnsCache = new();

    protected override async Task OnInitializedAsync()
    {
        using var db = await this.DbFactory.Create<DartsDb>();
        _items = db.MatchRecords.ToList();

        if (!string.IsNullOrEmpty(SessionId))
        {
            var targetItem = _items.FirstOrDefault(x => x.SessionId == SessionId);
            if (targetItem != null)
            {
                _expandedItems.Add(targetItem.Id);
            }
        }
    }

    private bool IsSessionHighlighted(MatchRecord item)
    {
        return !string.IsNullOrEmpty(SessionId) && item.SessionId == SessionId;
    }

    private bool IsDetailShown(MatchRecord item)
    {
        return _expandedItems.Contains(item.Id);
    }

    private void ToggleDetail(MatchRecord item)
    {
        if (_expandedItems.Contains(item.Id))
            _expandedItems.Remove(item.Id);
        else
            _expandedItems.Add(item.Id);
    }

    private List<TurnResult> GetDetailedTurns(MatchRecord item)
    {
        if (_detailedTurnsCache.ContainsKey(item.Id))
            return _detailedTurnsCache[item.Id];

        var turns = new List<TurnResult>();
        try
        {
            if (!string.IsNullOrEmpty(item.DetailedTurnsJson))
            {
                turns = JsonSerializer.Deserialize<List<TurnResult>>(item.DetailedTurnsJson) ?? new List<TurnResult>();
            }
        }
        catch { }
        _detailedTurnsCache[item.Id] = turns;
        return turns;
    }
}
